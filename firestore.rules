rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Top-level rules: Only authenticated users can access,
    // and they can only access their own documents
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /waterLogs/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /doseLogs/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /medications/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /evaluations/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /settings/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
